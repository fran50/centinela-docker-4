# Dirección que usará el navegador para acceder al equipo Docker.
# Para uso local: localhost
# Para otros equipos de la red: IP del servidor, por ejemplo 192.168.1.50
PUBLIC_HOST=localhost

FRONTEND_PORT=8088
API_PORT=3001
WS_PORT=8080
MQTT_BROKER=mqtt://host.docker.internal:1883
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password123

MQTT_TOPIC=casa/estacion
MONGODB_DB=estacion_meteorologica
STATION_ID=estacion-001
LOCATION_ID=talavera-01
TIME_ZONE=Europe/Madrid
SAMPLE_INTERVAL_SECONDS=3
AGGREGATION_GRACE_SECONDS=8
MAX_API_POINTS=5000
ADMIN_API_KEY=cambia-esta-clave
